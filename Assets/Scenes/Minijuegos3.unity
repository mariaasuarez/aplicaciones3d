  m_Name: 
  m_EditorClassIdentifier: 
  textoPantallaPrincipal: {fileID: 200654047}
  audioSourceManager: {fileID: 1134460082}
  sonidoAcierto: {fileID: 8300000, guid: ecf4e3242364d324996317fad46f68e7, type: 3}
  sonidoVictoria: {fileID: 8300000, guid: ecf4e3242364d324996317fad46f68e7, type: 3}
  sonidoError: {fileID: 8300000, guid: de560124d6cca2c44bdc8ad016c37e1f, type: 3}
  maxFallosPermitidos: 3
  gestorDeSecretos: {fileID: 1134460085}
  cuadrosData:
  - nombrePersonaje: Alexander Ceron
    acertijos:
    - "Soy el \xFAnico cuyo nombre podr\xEDa encajar en las p\xE1ginas de un libro
      de historia antigua."
    - "Si recuerdas qui\xE9n fue Alejandro, estar\xE1s cerca de encontrarme."
  - nombrePersonaje: Heliot Sanchez
    acertijos:
    - "Mi nombre guarda un secreto brillante. Entre los cuatro, soy el m\xE1s cercano
      al Sol."
    - "Mi nombre parece esconder al astro que ilumina la Tierra. Si el Sol te sirve
      de gu\xEDa, sabr\xE1s d\xF3nde mirar."
  - nombrePersonaje: Freddy Leon
    acertijos:
    - No tengo melena ni garras, pero mi apellido ruge como el rey de la sabana.
    - "Mi apellido podr\xEDa ser el de un rey salvaje. Estoy en la pared opuesta
      a quien esconde el Sol."
  - nombrePersonaje: German Garnica
    acertijos:
    - Estoy junto a quien ruge sin ser animal.
    - "Algunos apellidos suenan ligeros. El m\xEDo pesa toneladas."
